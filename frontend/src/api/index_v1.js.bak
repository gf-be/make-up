import request from '@/utils/request'

// 仪表板
export const getDashboardStats = () => {
  return request.get('/dashboard/stats')
}

export const getDashboardTrends = () => {
  return request.get('/dashboard/trends')
}

// 政策
export const getPolicies = (params) => {
  return request.get('/policies', { params })
}

export const getPolicyDetail = (id) => {
  return request.get(`/policies/${id}`)
}

export const getPolicyCategories = () => {
  return request.get('/policies/categories/list')
}

